# Copy to .env and fill in. .env is git-ignored: never commit it.

# Generate one with:
# python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me

# True only on your own machine. Static files and uploads are only served in debug mode.
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_PASSWORD=change-me
# Only if PostgreSQL is not on localhost:5432.
DB_HOST=localhost
DB_PORT=5432

# From your Khalti merchant dashboard.
KHALTI_SECRET_KEY=change-me

# From Sparrow SMS. Login OTP messages will not send without it.
SPARROW_SMS_TOKEN=change-me

# Only if GeoDjango cannot find GDAL and GEOS on PATH.
# GDAL_LIBRARY_PATH=C:\OSGeo4W\bin\gdal309.dll
# GEOS_LIBRARY_PATH=C:\OSGeo4W\bin\geos_c.dll
